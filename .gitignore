# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Data
data/raw/*
data/processed/*.npy
data/processed/*.json
!data/raw/.gitkeep
!data/processed/.gitkeep

# Real-data track: COST2100 tensors are multi-hundred-MB, regenerate with
# python data/prepare_cost2100.py
data/processed_cost2100/
data/processed_deepmimo/

# DeepMIMO scenario cache: 2.4 GB zip plus extracted ray-tracing data.
# Re-fetch with deepmimo.download('o1_3p5').
deepmimo_scenarios/

# Models
models/weights/*.pt
!models/weights/.gitkeep

# Results. Everything under results/ is generated -- metrics, per-epoch logs,
# figures, ablation sweeps, per-dataset subdirectories. Ignore the lot rather
# than enumerating extensions, so new output directories do not silently show
# up as untracked.
results/**
!results/.gitkeep
!results/figures/.gitkeep

# Weights for the alternate dataset tracks
models/weights_deepmimo/
models/weights_cost2100/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
